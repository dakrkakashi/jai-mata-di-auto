# Jai Mata Di Auto — Backend Environment Configuration
# Copy this file to .env and fill in your real values

# Server Environment
PORT=3000
NODE_ENV=development

# JWT Secret (REQUIRED in production: 32+ char secure random string)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_hex_or_passphrase_here

# Admin Dashboard Password (REQUIRED in production: min 6 chars)
ADMIN_PASSWORD=your_secure_admin_password_here

# Nodemailer / Gmail SMTP Credentials (used for lead notifications and test emails)
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASS=your-gmail-app-password
# Legacy aliases also supported:
# SMTP_EMAIL=your-gmail@gmail.com
# SMTP_PASSWORD=your-gmail-app-password

# Public Site URL (used for SEO and sitemap generation)
SITE_URL=https://jaimatadiauto.com

# WhatsApp / CallMeBot (Optional lead alerts)
CALLMEBOT_PHONE_1=919960091371
CALLMEBOT_KEY_1=your_callmebot_api_key_1
CALLMEBOT_PHONE_2=919890202091
CALLMEBOT_KEY_2=your_callmebot_api_key_2
