# ==============================================================================
# JAI MATA DI AUTO — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in jmd/backend/ and populate the values for your deployment.
# ==============================================================================

# Server Network Settings
PORT=3000
NODE_ENV=development

# Security & Admin Authentication
# REQUIRED IN PRODUCTION: Minimum 32 random characters.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_min_32_characters_here

# Initial Admin Password (minimum 6 characters)
# On first run, this is bcrypt-hashed and stored securely in backend/data/settings.json
ADMIN_PASSWORD=your_secure_admin_password_here

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of permitted frontend origins
# In production: https://jaimatadiauto.in,https://admin.jaimatadiauto.in
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Cookie Configuration for Cross-Subdomain Admin Sessions
# Leave empty for localhost development.
# In production on subdomains (e.g. api.jaimatadiauto.in & admin.jaimatadiauto.in), set: .jaimatadiauto.in
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Reverse Proxy Configuration
# Set to '1', 'loopback', or 'true' when deployed behind Caddy, Nginx, or Cloudflare
TRUST_PROXY=1

# Email Notification Settings (Gmail SMTP)
# Used to send instant lead notifications to dealership management
GMAIL_USER=
GMAIL_PASS=
# Aliases supported by mailer:
# SMTP_EMAIL=
# SMTP_PASSWORD=

# Public Site URL (used for links in email notifications)
SITE_URL=http://localhost:3000

# CallMeBot WhatsApp Alerts (Optional)
# If configured, sends WhatsApp lead alerts
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
